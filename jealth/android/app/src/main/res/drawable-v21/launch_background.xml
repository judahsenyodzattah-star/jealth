<?xml version="1.0" encoding="utf-8"?>
<!-- J'ealth launch screen: brand background with the centred logo. It is shown
     only until Flutter draws its first frame (the in-app splash continues it). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/jealth_launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
